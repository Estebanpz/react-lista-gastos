# Copia este archivo a .env.local y rellena los valores desde
# Firebase Console > Configuración del proyecto > Tus apps.
# .env.local está ignorado por git. NO pongas valores reales aquí.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
# Clave pública de «Certificados web push» (Firebase Console > Cloud Messaging). Es pública, pero va aquí.
REACT_APP_FIREBASE_VAPID_KEY=
# Clave del sitio de reCAPTCHA Enterprise para App Check (Google Cloud > Fraud Defense). Es pública.
REACT_APP_RECAPTCHA_SITE_KEY=

# Número de WhatsApp para renovar planes (solo dígitos con indicativo, ej. 573001234567)
REACT_APP_WHATSAPP_RENOVAR=

# Dirección del Worker de Cloudflare que crea clientes desde el panel de super admin (https://recordatorios-gastos.<subdominio>.workers.dev)
REACT_APP_API_CLIENTES=
