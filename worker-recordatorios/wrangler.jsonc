{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recordatorios-gastos",
  "main": "src/index.js",
  // Actualizar a la fecha del día al desplegar (skill workers-best-practices) y volver a correr las pruebas
  "compatibility_date": "2026-11-06",
  // URL workers.dev activada para la API del panel de super admin (POST /clientes). Se protege con el ID token de Firebase +
  // pertenencia a super_admins; el resto de rutas devuelve 404. El cron sigue funcionando igual.
  "workers_dev": true,
  "preview_urls": false,
  // El cron de Cloudflare siempre es UTC; Colombia es UTC-5 sin horario de verano.
  // 13:00 UTC = 8:00 (avisos de 3 días, planes y programación del SMS de las 8:30).
  // 13:30, 16:30, 19:30 y 22:30 UTC = 8:30, 11:30, 14:30 y 17:30: push del día del pago por turnos (src/functions/recurrencias.js).
  "triggers": { "crons": ["0 13 * * *", "30 13,16,19,22 * * *"] },
  // Logs y trazas de todas las ejecuciones (es una al día). Los logs solo llevan conteos.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  // No secreto. La clave de la cuenta de servicio es el secreto GOOGLE_SA_JSON (wrangler secret put)
  "vars": { "GCP_PROJECT_ID": "react-lista-gastos-5d794" },
  // wrangler avisa si falta el secreto al desplegar o en desarrollo. Opcionales: LABS_MOBILE_USER y LABS_MOBILE_TOKEN (SMS); sin ellos no se envían SMS
  "secrets": { "required": ["GOOGLE_SA_JSON"] }
}
