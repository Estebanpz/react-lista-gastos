{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recordatorios-gastos",
  "main": "src/index.js",
  // Actualizar a la fecha del día al desplegar (skill workers-best-practices) y volver a correr las pruebas
  "compatibility_date": "2026-10-05",
  // Sin URL pública: el Worker solo reacciona al cron (no hay handler fetch)
  "workers_dev": false,
  "preview_urls": false,
  // 13:00 UTC = 08:00 en Bogotá (Colombia no tiene horario de verano). El cron de Cloudflare siempre es UTC.
  "triggers": { "crons": ["0 13 * * *"] },
  // Logs y trazas de todas las ejecuciones (es una al día). Los logs solo llevan conteos.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  // No secreto. La clave de la cuenta de servicio es el secreto GOOGLE_SA_JSON (wrangler secret put)
  "vars": { "GCP_PROJECT_ID": "react-lista-gastos-5d794" },
  // wrangler avisa si falta el secreto al desplegar o en desarrollo
  "secrets": { "required": ["GOOGLE_SA_JSON"] }
}
